#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 CiroBoxHub
# watchface-hook EVENTO — lo stato di una sessione di Claude Code per il pannello.
#
# Claude Code lo lancia a ogni evento (hook in ~/.claude/settings.json, li
# mette e li toglie watchface-hooks.py) con il JSON dell'evento sullo stdin.
# Scrive una riga per sessione in $XDG_RUNTIME_DIR, che sta in memoria: il
# pannello la legge quando cambia, senza interrogare niente a intervalli.
#
#   evento <TAB> epoca <TAB> fallimenti di fila <TAB> aiutanti <TAB> cwd <TAB> pid
#
# Il pid è quello del processo `claude` (CLAUDE_PID, che Claude Code passa ai
# suoi hook): da lì il pannello risale al terminale e ne porta davanti la
# finestra. Vuoto se la variabile non c'è.
#
# Tre regole, perche' gira a ogni passo di Claude:
# - NIENTE OUTPUT. Per PermissionRequest lo stdout di un hook e' una risposta:
#   una riga sbagliata qui approverebbe o negherebbe un comando.
# - USCITA SEMPRE 0, e niente che possa bloccare: un hook che si inceppa
#   ferma Claude.
# - Bash e solo builtin dove si puo': un processo Python costerebbe 30-80 ms a
#   ogni strumento usato. Si forka per il lock, per la rinomina, per mkdir la
#   prima volta e per scartare la coda di un payload grosso.
exec >/dev/null 2>&1

evento=$1
[[ $evento =~ ^[A-Za-z]{1,40}$ ]] || exit 0
# Solo le sessioni di una persona. Quelle avviate da un programma — `claude -p`
# o l'SDK, che Claude Code marca con CLAUDE_CODE_ENTRYPOINT=sdk-… (verificato
# il 2026-10-03: «cli» nel terminale, «sdk-cli» con -p) — nessuno le guarda:
# skillspector ne apre una per analisi, la lettura della quota una a ogni
# «Aggiorna». WATCHFACE_IGNORA la mette collect-usage.py, per le versioni di
# Claude Code senza la variabile. Il payload si scarta comunque (EPIPE).
if [[ -n ${WATCHFACE_IGNORA:-} || ${CLAUDE_CODE_ENTRYPOINT:-} == sdk-* ]]; then
    cat >/dev/null
    exit 0
fi

# La testa basta: session_id e cwd sono fra i primi campi. Un Write da
# qualche MB porta il contenuto nel payload; si legge la testa e il resto si
# scarta, ma va letto tutto, se no chi scrive riceve un EPIPE.
#
# Per gli eventi degli aiutanti la testa e' piu' lunga: se il rapporto finale
# precede agent_id, l'id cade oltre gli 8 KB, non si trova, e la rimozione
# fallisce in silenzio lasciando l'aiutante contato per sempre. Riprodotto il
# 2026-10-06 con un payload da 9 KB: SubagentStop non toglieva niente.
testa=8192
[[ $evento == Subagent* ]] && testa=262144
IFS= read -r -d '' -N $testa dati
(( ${#dati} >= testa )) && cat >/dev/null

# L'id finisce in un nome di file: solo lettere, cifre e trattini, cosi'
# un «../» non porta fuori dalla cartella.
[[ $dati =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([A-Za-z0-9-]{1,64})\" ]] || exit 0
sid=${BASH_REMATCH[1]}
cwd=
[[ $dati =~ \"cwd\"[[:space:]]*:[[:space:]]*\"(([^\"\\]|\\.)*)\" ]] && cwd=${BASH_REMATCH[1]}
cwd=${cwd//$'\t'/ }

base=${XDG_RUNTIME_DIR:-/run/user/$UID}
dir=$base/claude-code-watchdog/watchface
[[ -d $dir ]] || mkdir -p -m 700 "$dir" || exit 0
f=$dir/$sid

# Leggi-modifica-scrivi sotto lock: gli aiutanti partono in parallelo e i loro
# SubagentStart arrivano insieme. Senza lock venti avvii ne contavano otto
# (riprodotto dalla revisione del 2026-10-03). Al massimo due secondi di
# attesa: meglio perdere un aggiornamento che fermare Claude.
exec 9>"$f.lock" && flock -w 2 9 || exit 0

if [[ $evento == SessionEnd ]]; then
    rm -f -- "$f" "$f.aiutanti" "$f.lock"
    exit 0
fi

# Un aiutante piu' vecchio di cosi' si considera finito: vedi la potatura.
AIUTANTE_SCADENZA_S=3600
printf -v ora '%(%s)T' -1

prima=Nessuno fallimenti=0 aiutanti=0
[[ -f $f ]] && IFS=$'\t' read -r prima _ fallimenti aiutanti _ < "$f"
[[ $fallimenti =~ ^[0-9]+$ ]] || fallimenti=0
[[ $aiutanti =~ ^[0-9]+$ ]] || aiutanti=0

# A turno chiuso (Stop o StopFailure) lo stato resta quello: la Notification
# che arriva dopo un minuto di inattivita' («waiting for your input») non e'
# una domanda nuova, e la fine di un aiutante in background non riapre il
# lavoro. Gli aiutanti pero' si contano lo stesso.
chiuso=0
[[ $prima == Stop || $prima == StopFailure ]] && chiuso=1
# Il /compact, a mano o automatico quando il contesto è pieno: PreCompact
# all'inizio, SessionStart con source «compact» alla fine, e nient'altro —
# niente UserPromptSubmit, niente Stop (eventi registrati il 2026-10-04 con
# Claude Code 2.1.289). Il «trigger» c'è solo nel PreCompact, quindi resta
# nel nome dell'evento: alla fine serve sapere se Claude torna a te (a mano)
# o riprende il turno che stava facendo (automatico). PostCompact non serve:
# le versioni vecchie non lo mandano, SessionStart(compact) sì.
compatta=0
[[ $prima == PreCompact || $prima == PreCompactAuto ]] && compatta=1
riparte=0
[[ $evento == SessionStart && $dati =~ \"source\"[[:space:]]*:[[:space:]]*\"compact\" ]] && riparte=1
nuovo=$evento
case $evento in
    Notification) (( chiuso )) && exit 0 ;;
    SubagentStart|SubagentStop) (( chiuso || compatta )) && nuovo=$prima ;;
    PreCompact)
        [[ $dati =~ \"trigger\"[[:space:]]*:[[:space:]]*\"auto\" ]] && nuovo=PreCompactAuto ;;
    PostToolUseFailure) (( fallimenti++ )) ;;
    PostToolUse|UserPromptSubmit|Stop) fallimenti=0 ;;
    SessionStart)
        if (( riparte )); then
            # Fine del compact. Senza un PreCompact prima non si sa cosa
            # stesse facendo: si lascia la riga com'è.
            (( compatta )) || exit 0
            if [[ $prima == PreCompact ]]; then
                nuovo=Stop fallimenti=0
            else
                nuovo=PostToolUse
            fi
        else
            fallimenti=0
        fi ;;
esac
# Gli aiutanti si contano per id, non con un contatore: Claude Code manda
# SubagentStop anche per agenti interni mai partiti (agent_type vuoto), che
# toglievano il robot a un aiutante vero; e un aiutante che aspetta un lavoro
# in background manda Stop, poi Start di nuovo quando si risveglia (eventi
# registrati il 2026-10-03). Senza agent_id — versioni vecchie — si torna a
# contare: ogni Start aggiunge un «anonimo», ogni Stop ne toglie uno.
# L'elenco degli aiutanti: una riga «id <TAB> epoca di avvio».
#
# L'epoca c'e' perche' un aiutante il cui SubagentStop non arriva qui
# resterebbe contato per sempre. Succede, e non per colpa nostra: gli aiutanti
# in background girano in processi `claude` figli, con un session_id loro, e
# lo Stop finisce nel file del figlio mentre lo Start sta in quello del padre.
# Il 2026-10-06 una sessione ne mostrava sette, fermi dalle 11:52, ancora
# contati alle 15:40.
# Si potano a ogni evento e non solo ai Subagent*: una sessione al lavoro
# manda eventi di continuo, cosi' il numero scende da se'. Il prezzo e' che un
# aiutante che lavora davvero per piu' di un'ora smette di essere contato:
# meglio dire uno di meno che tenerne sette che non esistono.
# Le righe senza epoca sono del formato vecchio: si buttano, e il conto si
# rifa' dagli eventi nuovi.
elenco_f=$f.aiutanti
elenco=() letti=0
if [[ -s $elenco_f ]]; then
    while IFS=$'\t' read -r _aid _ep; do
        (( letti++ ))
        [[ $_ep =~ ^[0-9]+$ ]] || continue
        (( ora - _ep < AIUTANTE_SCADENZA_S )) && elenco+=("$_aid"$'\t'"$_ep")
    done < "$elenco_f"
fi
# L'elenco e' la fonte: il numero nella riga di stato si ricava da lui, mai il
# contrario, se no i due divergono e vince quello sbagliato.
aiutanti=${#elenco[@]}
# Se la potatura ha tolto qualcosa il file va riscritto anche quando l'evento
# non riguarda gli aiutanti, se no resta lungo per sempre.
scrivi_elenco=0
(( letti != aiutanti )) && scrivi_elenco=1

case $evento in
    SubagentStart|SubagentStop)
        aid=anonimo
        [[ $dati =~ \"agent_id\"[[:space:]]*:[[:space:]]*\"([A-Za-z0-9_-]{1,64})\" ]] && aid=${BASH_REMATCH[1]}
        trovato=-1
        for i in "${!elenco[@]}"; do
            [[ ${elenco[i]%%$'\t'*} == "$aid" ]] && { trovato=$i; break; }
        done
        if [[ $evento == SubagentStart ]]; then
            (( trovato < 0 )) || [[ $aid == anonimo ]] && elenco+=("$aid"$'\t'"$ora")
        elif (( trovato >= 0 )); then
            unset 'elenco[trovato]'
        fi
        scrivi_elenco=1
        aiutanti=${#elenco[@]}
        ;;
    # Una sessione nuova o ripresa riparte senza aiutanti; dopo un compact
    # quelli in background sono ancora al lavoro.
    SessionStart)
        if (( ! riparte )); then
            elenco=()
            scrivi_elenco=1
            aiutanti=0
        fi ;;
esac
# Su un temporaneo e poi rinomina, come la riga di stato: il pannello legge
# questo file **senza prendere il lock**, e fra il troncamento e la scrittura
# resterebbe vuoto per un istante. Una lettura che ci cadesse dentro
# conterebbe zero aiutanti, e con una sessione ferma su Stop farebbe scattare
# un «Claude ha finito» che non e' vero. Rilevato da /code-review il
# 2026-10-06, nel secondo giro sulla correzione del primo.
if (( scrivi_elenco )); then
    if (( ${#elenco[@]} )); then
        printf '%s\n' "${elenco[@]}" > "$elenco_f.$$"
    else
        : > "$elenco_f.$$"
    fi
    mv -f -- "$elenco_f.$$" "$elenco_f"
fi

# Su un temporaneo e poi rinomina: chi legge vede la riga vecchia o la nuova,
# mai un file troncato a meta'. L'ora e' quella presa in cima, con un builtin
# anche dove EPOCHSECONDS non c'e' (bash prima della 5.0): un'epoca 0 farebbe
# sembrare la sessione vecchia di decenni, e il pannello la cancellerebbe
# appena letta.
pid=${CLAUDE_PID:-}
[[ $pid =~ ^[0-9]{1,10}$ ]] || pid=
printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$nuovo" "$ora" \
    "$fallimenti" "$aiutanti" "$cwd" "$pid" > "$f.$$" && mv -f -- "$f.$$" "$f"
exit 0
