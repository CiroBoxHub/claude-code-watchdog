# Prodotti, non sorgenti: si rigenerano con ./bin/pack-extension.sh
dist/

# Report datati: utili sulla macchina, rumore nella cronologia
reports/

# Compilato dallo schema, ricreato a ogni installazione
*.gschemas.compiled
gschemas.compiled

# Copie degli script dentro la cartella dell'estensione: le mettono
# install-extension.sh e pack-extension.sh copiandole da bin/, e averle
# versionate due volte significa vederle divergere senza accorgersene.
# Un motivo solo invece dell'elenco: l'elenco va aggiornato a ogni script
# nuovo, e chi se ne dimentica se ne accorge quando la copia e' gia' committata.
# Sorgenti .py dentro l'estensione non ce ne sono: e' tutto JavaScript.
gnome-extension/*/*.py

__pycache__/
*.pyc
